# Copy to .env and edit. .env is gitignored. Never commit real tokens.
# All values are optional; they override configs/model.yaml.

# Hugging Face access token (only needed for gated/private models; Qwen3 is public)
# HF_TOKEN=

# Model overrides
# REGULUS_MODEL_ID=Qwen/Qwen3-0.6B
# REGULUS_MODEL_CACHE_DIR=models
# REGULUS_DEVICE=auto          # auto | cpu | mps | cuda | cuda:0   (mps = Apple GPU, opt-in; auto never picks it)
# REGULUS_DTYPE=auto           # auto | float32 | float16 | bfloat16

# Optional: silence the Windows "cache-system uses symlinks" warning
# HF_HUB_DISABLE_SYMLINKS_WARNING=1

# PostgreSQL connection for the read-only retrieval layer (Stage 5).
# Use a least-privilege read role in shared environments; the session is forced read-only regardless.
# REGULUS_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/regulus
