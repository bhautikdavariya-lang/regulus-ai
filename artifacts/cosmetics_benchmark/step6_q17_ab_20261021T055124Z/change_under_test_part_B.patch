+"""The general-question format line (REGULUS_GENERAL_ANSWER_FORMAT; off by default).
+
+Through the real pipeline in its production answer shape ("adaptive") with a scripted model. Pinned:
+  * off, every prompt, package record and pipeline fingerprint is exactly as before;
+  * on, a general question's prompt differs only in its last line: the general-question line plus the plan
+    line's rule against dropping conditions, never "the requested provision", led by any Stage 3 profile;
+  * provision and docket prompts and records are byte-identical either way;
+  * a run with the switch on is marked in the package record and in the pipeline fingerprint.
+"""
+from __future__ import annotations
+
+import os
+
+import pytest
+
+from regulus.rag import RagConfig, RagPipeline
+from regulus.rag import generation as G
+from regulus.rag.answer_plan import _KEEP
+from regulus.retrieval import LexicalRetriever
+from regulus.system_identity import pipeline_config
+from tests.test_answer_shape import BROAD, COMPARE, EXHAUSTIVE, FOCUSED, TABLE
+from tests.test_answer_validation import ScriptedGenerator
+from tests.test_retrieval_plan import TableDatabase, guidance_row, row
+
+ROWS = [row("700.18", "(a)", 0, rank=0.5, text="Any cosmetic product containing chloroform as an ingredient is deemed adulterated."),
+        row("700.18", "(b)", 1, rank=0.4, text="Chloroform remaining as a residue from its use as a processing solvent is not "
+                                              "considered an ingredient.")]
+GENERAL = {   # every mode a question that names no provision can take (regulus.planning.shape)
+    "synthesis": "May a face cream contain chloroform left over from processing?",
+    "direct": "What is a coal-tar hair dye?",
+    "comparison": "Compare the warning statements for feminine deodorant sprays and aerosol cosmetics.",
+    "enumeration": "List all colour additives exempt from certification.",
+}
+GENERAL_LINE = G._FORMAT[G.SHAPE_GENERAL] + " " + _KEEP
+
+
+def ask(question, db, monkeypatch, *, enabled, answer_shape="adaptive"):
+    """The user turn the model receives, the answer, and its package record, all with the switch set as given
+    (the switch is fixed for a process; here it changes between calls, so the record is taken now)."""
+    monkeypatch.setattr(G, "GENERAL_ANSWER_FORMAT_ENABLED", enabled)
+    g = ScriptedGenerator("Scripted answer [1].")
+    out = RagPipeline(LexicalRetriever(db()), g, RagConfig(answer_shape=answer_shape)).answer(question)
+    assert g.calls, "the model was not called"
+    return g.calls[0]["messages"][1]["content"], out, out.package.to_dict()
+
+
+def general_db():
+    return TableDatabase(full_text=list(ROWS))
+
+
+def test_the_switch_is_off_unless_set():
+    if os.environ.get("REGULUS_GENERAL_ANSWER_FORMAT") == "1":
+        pytest.skip("REGULUS_GENERAL_ANSWER_FORMAT=1 is set in this environment")
+    assert G.GENERAL_ANSWER_FORMAT_ENABLED is False
+
+
+def test_off_a_general_question_keeps_its_plan_line(monkeypatch):
+    prompt, _, record = ask(GENERAL["synthesis"], general_db, monkeypatch, enabled=False)
+    assert "REQUESTED PROVISIONS:\nnone (general question)" in prompt
+    last = prompt.split("\n")[-1]
+    assert last.startswith("ANSWER FORMAT: a synthesized overview") and "the requested provision" in last
+    assert "format_line" not in record
+
+
+@pytest.mark.parametrize("mode", sorted(GENERAL))
+def test_on_a_general_question_gets_the_general_line_and_nothing_else_changes(monkeypatch, mode):
+    off, _, record_off = ask(GENERAL[mode], general_db, monkeypatch, enabled=False)
+    on, out_on, record_on = ask(GENERAL[mode], general_db, monkeypatch, enabled=True)
+    assert out_on.package.shape == G.SHAPE_GENERAL and out_on.package.answer_plan.mode == mode
+    off_lines, on_lines = off.split("\n"), on.split("\n")
+    assert on_lines[:-1] == off_lines[:-1]                      # question, provisions, evidence and notes unchanged
+    assert on_lines[-1] == GENERAL_LINE and "requested provision" not in on_lines[-1]
+    assert record_on["format_line"] == G.SHAPE_GENERAL and "format_line" not in record_off
+    assert {k: v for k, v in record_on.items() if k != "format_line"} == record_off
+
+
+def test_on_the_stage3_profile_lead_and_its_caveats_are_kept(monkeypatch):
+    on, out, _ = ask(GENERAL["synthesis"], general_db, monkeypatch, enabled=True, answer_shape="structured")
+    profile = out.package.profile
+    assert profile and on.split("\n")[-1] == "ANSWER FORMAT: " + profile + " " + GENERAL_LINE[len("ANSWER FORMAT: "):]
+
+
+@pytest.mark.parametrize("question, db", [
+    (BROAD, lambda: TableDatabase(TABLE)),
+    (FOCUSED, lambda: TableDatabase(TABLE)),
+    (EXHAUSTIVE, lambda: TableDatabase(TABLE)),
+    (COMPARE, lambda: TableDatabase(TABLE)),
+    ("Summarise FDA-2016-D-2565", lambda: TableDatabase(docket=[guidance_row(0), guidance_row(1)])),
+], ids=["section", "paragraph", "enumeration", "comparison", "docket"])
+def test_provision_and_docket_prompts_are_byte_identical(monkeypatch, question, db):
+    off, _, record_off = ask(question, db, monkeypatch, enabled=False)
+    on, out_on, record_on = ask(question, db, monkeypatch, enabled=True)
+    assert out_on.package.shape != G.SHAPE_GENERAL
+    assert on == off and record_on == record_off
+
+
+def test_the_pipeline_fingerprint_marks_the_switch_only_when_on(monkeypatch):
+    monkeypatch.setattr(G, "GENERAL_ANSWER_FORMAT_ENABLED", False)
+    off = pipeline_config(RagConfig())
+    assert set(off["prompt"]) == {"system_prompt_sha256", "answer_shape"}       # the shape it had before the switch
+    monkeypatch.setattr(G, "GENERAL_ANSWER_FORMAT_ENABLED", True)
+    on = pipeline_config(RagConfig())
+    assert on["prompt"]["general_answer_format"] is True
+    assert {**on, "prompt": {k: v for k, v in on["prompt"].items() if k != "general_answer_format"}} == off
