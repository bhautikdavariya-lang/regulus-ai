+def _focus_gap(package, intent, answering, claims, passages) -> tuple[list[str], list[str]] | None:
+    """For a FOCUSED question (a topic inside the requested provision), the requirement
+    groups of that provision that are on the question's topic, state an obligation,
+    and that no answering statement covers: (missing, addressed_but_unverified).
+
+    The pipeline checks group coverage only for a synthesis (shape validation's
+    material_group_uncovered, repaired by appending the group). A focused answer was
+    never checked: "What are the personnel qualification requirements in 21 CFR
+    211.25?" answered with 211.25(c) alone was PASS, though (a) and (b) state the
+    section's other personnel-qualification requirements - rubric O=0, "a material
+    governing requirement is omitted". Read from what the RagAnswer carries (the
+    package's answer plan); None when there is no focused plan to read."""
+    plan = getattr(package, "answer_plan", None)
+    if plan is None or getattr(getattr(plan, "shape", None), "mode", None) != "focused" or not intent.topic:
+        return None
+    requested = {rid for rid, _ in (getattr(package, "requirements", None) or ())}
+    by_index = {p.source_index: p for p in passages}
+    decided = (AN.SUPPORTED, AN.SUPPORTED_WITH_CITATION_DEFECT, AN.PARTIALLY_SUPPORTED, AN.CONTRADICTED)
+    covered = {e.get("source_index") for c in answering if c.final in decided for e in c.evidence[:1]}
+    # a statement that could not be verified may still be ABOUT a group (a paraphrase): its evidence or the
+    # passage the aligner matched it to first; such a group is unverified, not omitted
+    by_citation = {p.citation: p.source_index for p in passages}
+    touched = {e.get("source_index") for c in claims if c.final == AN.UNVERIFIABLE for e in c.evidence}
+    touched |= {by_citation.get(c.candidate_evidence[0]) for c in claims
+                if c.final == AN.UNVERIFIABLE and c.candidate_evidence}
+    missing: list[str] = []
+    maybe: list[str] = []
+    for g in getattr(plan, "groups", ()) or ():
+        if getattr(g, "kind", None) != "requirement" or not set(g.requirement_ids) & requested:
+            continue
+        members = [by_index[i] for i in g.members if i in by_index]
+        if not members or covered & set(g.members):
+            continue
+        if not any(OP.strength(p.text) == OP.MANDATORY for p in members):
+            continue                                  # states no obligation (definitions, permissions)
+        if not RV.on_topic(intent, members):
+            continue                                  # outside what the question asks about
+        label = g.label + (f" ({g.heading})" if getattr(g, "heading", None) else "")
+        (maybe if touched & set(g.members) else missing).append(label)
+    return missing, maybe
 
 
