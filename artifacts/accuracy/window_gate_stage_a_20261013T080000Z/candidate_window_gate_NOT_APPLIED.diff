+WINDOW_MIN_OWN_TERMS = 3
+
+
+def _each_sentence_needed(claim: str, halves: Sequence[str]) -> bool:
+    """A paraphrased window is still NEEDED and USED when each sentence alone
+    carries >= 3 of the claim's core terms that the other sentence lacks."""
+    from regulus.accuracy.intent import same_term
+
+    core = core_terms(claim)
+    stems = [_stems(h) for h in halves]
+    has = lambda t, s: any(same_term(t, x) for x in s)
+    return all(sum(1 for t in core if has(t, stems[i]) and not has(t, stems[1 - i])) >= WINDOW_MIN_OWN_TERMS
+               for i in (0, 1))
 
 
