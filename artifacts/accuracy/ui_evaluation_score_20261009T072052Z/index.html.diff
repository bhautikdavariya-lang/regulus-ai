+// The evaluator's own score: regulus.accuracy.rubric.score() = max(0, 100 - deductions),
+// an integer from 0 to 100, issued only for an evaluated answer and forwarded by
+// regulus.accuracy.review as live_check_score. Shown only when it is exactly that;
+// never inferred from the status, never defaulted to 0 or 100. It never decides
+// the status either: a 90 can sit under FAIL.
+const SCORE_NOTE = "Evaluation score based on the system's checks; it is not a percentage of factual accuracy.";
+
+function evaluationScore(e) {
+  const s = e && typeof e === "object" ? e.live_check_score : undefined;
+  return typeof s === "number" && Number.isInteger(s) && s >= 0 && s <= 100 ? s : null;
+}
+
 function evalPill(e) {
   return e ? pill(`evaluation: ${e.label}`, EVAL_CLASS[e.status]) : "";
 }
