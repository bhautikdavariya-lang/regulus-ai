+def test_a_missing_score_field_shows_unavailable(tmp_path):
+    a = correct()
+    del a["question_review"]["live_check_score"]
+    r = shown(tmp_path, a)
+    assert ">PASS<" in r["block"] and score_line(r) == "Score unavailable"
