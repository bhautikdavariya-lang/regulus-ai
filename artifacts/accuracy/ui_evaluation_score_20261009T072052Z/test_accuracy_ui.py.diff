+def test_a_partial_answer_keeps_its_explanations_and_its_own_score(tmp_path):
+    a = evaluated(ONE, f"21 CFR 820.10(b)(2): {PURCHASING} [1] This duty is restated in 21 CFR 820.777.")
+    r = shown(tmp_path, a)
