+
+# A synthesis of a NAMED provision ("What does 21 CFR 312.32 require?") asks for the whole of it. The pipeline
+# checks a synthesis for missing requirement GROUPS and appends a missing group's head row, but a group counts
+# as present if any member is cited, named, word-matched or cross-referenced - so (c)(1) "covered" (c)(2), the
+# 7-day rule, as a member of the same group; (d)(3) "covered" itself because the answer mentions "paragraph
+# (c)", which (d)(3) cross-references; and an appended bare heading, "(d) Followup.", satisfied group (d).
+# The evaluator never checked a synthesis itself and passed every answer whose statements were supported.
+# Measured on 40 named sections answered completely (every top-level obligation verbatim) and with one
+# obligation left out (143 answers): production failed to pass 6 of the 143 incomplete answers; this check
+# fails to pass 132 of them and passes all 40 complete ones.
+SYNTHESIS_VERBATIM_RUN = 8       # words of an obligation's own text that show the answer reproduces it ...
+SYNTHESIS_VERBATIM_SHARE = 0.6   # ... covering at least this share of it, so shared boilerplate is not enough
+
+
+def _synthesis_gap(package, answer, answering, claims, passages) -> tuple[list[str], list[str], list[str]] | None:
+    """For a SYNTHESIS of a named provision: (missing, addressed_but_unverified, withheld_obligations).
+
+    The unit is a top-level obligation of the requested provision: a source that states a mandatory
+    requirement and is not a subparagraph of another source that does. Lists under one obligation are its
+    detail, not further units, so the check asks for the provision's obligations - not for every paragraph.
+    An obligation is represented by a statement verified against it, or by the answer reproducing it
+    (a verbatim run of at least SYNTHESIS_VERBATIM_RUN words - all of it, when it is shorter - that is also
+    SYNTHESIS_VERBATIM_SHARE of it: what repair appends counts, a shared stock phrase does not). A lead-in
+    ("Labeling must include:") is represented when it or any of its items is. A bare heading states no
+    obligation and so never stands in for one. As in _focus_gap, an obligation that only unverifiable
+    statements touch is unverified rather than omitted. None when the plan is not a synthesis of a named
+    provision.
+
+    `withheld_obligations` are obligation-bearing rows of the requested provision that the hard ceiling kept
+    out of the evidence: whatever the answer says, its completeness cannot then be established from it.
+    """
+    plan = getattr(package, "answer_plan", None)
+    requested = {rid for rid, _ in (getattr(package, "requirements", None) or ())}
+    if plan is None or getattr(getattr(plan, "shape", None), "mode", None) != "synthesis" or not requested:
+        return None
+    by_src = {s.index: s for s in getattr(package, "sources", ()) or ()}
+    decided = (AN.SUPPORTED, AN.SUPPORTED_WITH_CITATION_DEFECT, AN.PARTIALLY_SUPPORTED, AN.CONTRADICTED)
+    covered = {e.get("source_index") for c in answering if c.final in decided for e in c.evidence[:1]}
+    by_citation = {p.citation: p.source_index for p in passages}
+    touched = {e.get("source_index") for c in claims if c.final == AN.UNVERIFIABLE for e in c.evidence}
+    touched |= {by_citation.get(c.candidate_evidence[0]) for c in claims
+                if c.final == AN.UNVERIFIABLE and c.candidate_evidence}
+    mandatory = {i for i, s in by_src.items() if OP.strength(s.text or "") == OP.MANDATORY}
+    paths = {i: (getattr(s, "citation_fields", None) or {}).get("paragraph") or "" for i, s in by_src.items()}
+    answer_words = normalise(answer or "").split()
+
+    def reproduced(i: int) -> bool:
+        own = normalise(by_src[i].text or "")
+        n = len(own.split())
+        return n > 0 and longest_run(answer_words, own)[0] >= max(min(SYNTHESIS_VERBATIM_RUN, n), SYNTHESIS_VERBATIM_SHARE * n)
 
+    def represented(i: int) -> bool:
+        return i in covered or reproduced(i)
 
+    missing: list[str] = []
+    maybe: list[str] = []
+    for g in getattr(plan, "groups", ()) or ():
+        if getattr(g, "kind", None) != "requirement" or not set(g.requirement_ids) & requested:
+            continue
+        members = [i for i in g.members if i in by_src]
+        for i in [i for i in members if i in mandatory]:
+            if any(j != i and j in mandatory and paths[j] and paths[i].startswith(paths[j] + "(") for j in members):
+                continue                                   # the detail of another obligation, not a unit
+            items = ([j for j in members if paths[i] and paths[j].startswith(paths[i] + "(")]
+                     if (by_src[i].text or "").rstrip().endswith(":") else [])
+            if represented(i) or any(represented(j) for j in items):
+                continue
+            (maybe if (touched & ({i} | set(items))) else missing).append(by_src[i].citation)
+    withheld = sorted({c for c, t in getattr(package, "withheld", ()) or () if OP.strength(t or "") == OP.MANDATORY})
+    return missing, maybe, withheld
+
+
 def _group_text(members) -> str:
     return " ".join(f"{p.heading or ''} {p.text}" for p in members)
 
