+    m = re.match(r"^\s*(?:\([0-9A-Za-z]{1,6}\)\s*)*" + r"\s+".join(map(re.escape, term.split()))
+                 + r"\s+means\s+(?P<d>[^.;:]+?)\s*(?:[.;:]|$)", _US_RE.sub("US", passage_text or ""), re.I)
+    return _definition_words(m.group("d")) if m else None
+
