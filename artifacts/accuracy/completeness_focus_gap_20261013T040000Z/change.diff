+def _distinguishing_topic_terms(plan, intent, requested, by_index) -> set[str]:
+    """The question's topic words that tell the provision's ON-TOPIC obligation-bearing groups APART:
+    present in some of them and absent from others. Empty - and the focus gap then works exactly as
+    before - when there are fewer than two such groups or every topic word they carry is carried by all.
+
+    Only on-topic groups take part. A first version compared every obligation-bearing group, and then
+    an unrelated group decided the outcome: 21 CFR 312.32(b), "Review of safety information", lacks
+    suspected / adverse / reaction, so with it in the evidence those words stopped being shared and
+    (d) was demanded again. A group the question is not about says nothing about which words name it.
+
+    A focused question names its subject partly in words the whole provision shares. Asked for "the
+    reporting deadline for an unexpected fatal or life-threatening suspected adverse reaction",
+    21 CFR 312.32(d) - follow-up - was demanded because its (d)(3) carries four of the question's eight
+    topic words (report, suspected, adverse, reaction), the on-topic threshold. All four also appear
+    in (c), the group the answer covered; the words that say which deadline is meant - unexpected,
+    fatal, life-threatening - appear in (c) alone. So a correct "7 calendar days" answer failed
+    completeness for not covering follow-up.
+
+    Every group's own section heading is read too, so words of the heading every member carries never
+    distinguish anything. Measured before adoption on the 122 focused recorded acceptance answers: the
+    focus gap demands a group on 12, the hand rubric scores 11 of those incomplete (O=0), and this
+    leaves all 12 unchanged - each group it demands there carries a distinguishing word.
+    """
+    carried: list[set[str]] = []
+    for g in getattr(plan, "groups", ()) or ():
+        if getattr(g, "kind", None) != "requirement" or not set(g.requirement_ids) & requested:
+            continue
+        members = [by_index[i] for i in g.members if i in by_index]
+        if members and any(OP.strength(p.text) == OP.MANDATORY for p in members) and RV.on_topic(intent, members):
+            carried.append(set(IN.matched(intent.topic, IN.terms(_group_text(members)))))
+    if len(carried) < 2:
+        return set()
+    return set().union(*carried) - set.intersection(*carried)
 
 
