   "paragraph_path": "(i)(4)",
   "path_ordinal": 1,
   "ordinal": 22,
   "body_text": "Where the declaration is blown, embossed, or molded on a glass or plastic surface rather than by printing, typing, or coloring, the lettering sizes specified in paragraphs (i)(1) through (4) of this section shall be increased by one-sixteenth of an inch.",
