 "path_ordinal_examples": [
  {
   "section_number": "1.1102",
   "paragraph_path": "",
   "path_ordinal": 1,
   "t": "The definitions of terms in section 201 of the Federal Food, Drug, and Cosmetic Act apply to such terms when used in thi"
  },
  {
   "section_number": "1.1102",
   "paragraph_path": "",
   "path_ordinal": 2,
   "t": "Analyst means an individual who analyzes samples."
  },
  {
   "section_number": "1.1102",
   "paragraph_path": "",
   "path_ordinal": 3,
   "t": "Corrective action means an action taken by an accreditation body or laboratory to investigate and eliminate the cause of"
  },
  {
   "section_number": "1.1102",
   "paragraph_path": "",
   "path_ordinal": 4,
   "t": "Directed food laboratory order means an order issued by FDA under § 1.1108 requiring food testing to be conducted under "
  },
  {
   "section_number": "1.1102",
   "paragraph_path": "",
   "path_ordinal": 5,
   "t": "Food has the meaning given in section 201(f) of the Federal Food, Drug, and Cosmetic Act, except that food does not incl"
  },
  {
   "section_number": "1.1102",
   "paragraph_path": "",
   "path_ordinal": 6,
   "t": "Food testing and testing of food means the analysis of food product samples or environmental samples."
  },
  {
   "section_number": "1.1102",
   "paragraph_path": "",
   "path_ordinal": 7,
   "t": "Laboratory accreditation for analyses of foods (LAAF)-accreditation means a determination by a recognized accreditation "
  },
  {
   "section_number": "1.1102",
   "paragraph_path": "",
   "path_ordinal": 8,
   "t": "LAAF-accredited laboratory means a laboratory that a recognized accreditation body has determined meets the applicable r"
  }
 ],
