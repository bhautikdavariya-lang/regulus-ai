 "source": {
  "73.2250": {
   "live_rows": [
    {
     "path": "(a)",
     "ordinal": 0,
     "chars": 201,
     "tail": "ron oxides, including the hydrated forms. It is free from admixture with other substances.",
     "reserved": false,
     "ends_open": false,
     "has_children": false
    },
    {
     "path": "(b)",
     "ordinal": 1,
     "chars": 103,
     "tail": "tions. Iron oxides shall conform to the following specifications, all on an “as is” basis:",
     "reserved": false,
     "ends_open": true,
     "has_children": false
    },
    {
     "path": "(b)",
     "ordinal": 2,
     "chars": 153,
     "tail": "), not more than 10 parts per million. Mercury (as Hg), not more than 3 parts per million.",
     "reserved": false,
     "ends_open": false,
     "has_children": false
    },
    {
     "path": "(c)",
     "ordinal": 3,
     "chars": 196,
     "tail": "cs applied to the area of the eye, in amounts consistent with good manufacturing practice.",
     "reserved": false,
     "ends_open": false,
     "has_children": false
    },
    {
     "path": "(d)",
     "ordinal": 4,
     "chars": 229,
     "tail": "n to any information required by law, labeling in accordance with § 70.25 of this chapter.",
     "reserved": false,
     "ends_open": false,
     "has_children": false
    },
    {
     "path": "(e)",
     "ordinal": 5,
     "chars": 227,
     "tail": "efore batches thereof are exempt from certification pursuant to section 721(c) of the act.",
     "reserved": false,
     "ends_open": false,
